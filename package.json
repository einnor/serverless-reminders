{
  "name": "serverless-reminders",
  "version": "2.0.0",
  "private": true,
  "description": "Scheduled Lambda email reminders with SES, typed templates and offline previews.",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "preview": "npm run build && node scripts/preview.cjs",
    "package": "npm run build && serverless package",
    "deploy": "npm run build && serverless deploy"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.900.0",
    "juice": "^11.0.3",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^24.10.0",
    "@types/pug": "^2.0.10",
    "serverless": "^4.25.0",
    "typescript": "^5.9.3"
  }
}

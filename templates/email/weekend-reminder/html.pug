doctype html
html(lang="en")
  head
    title Weekend Reminder
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width")
  body(style="margin:0;background:#f1f5f9;font-family:Arial,sans-serif;color:#14213d")
    table(role="presentation" width="100%" cellpadding="0" cellspacing="0")
      tr
        td(align="center" style="padding:48px 20px")
          table(role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:100%;background:#ffffff;border-radius:16px")
            tr
              td(style="padding:40px")
                p(style="font-size:12px;letter-spacing:3px;color:#7c3aed;font-weight:bold") SERVERLESS REMINDERS
                h1(style="font-size:32px;line-height:1.2;margin:24px 0") Reflect. Reset. Start fresh.
                p(style="font-size:17px;line-height:1.7;color:#475569") A weekend check-in: review what moved forward, make space to recharge, and choose a priority for the week ahead.
                p(style="font-size:14px;line-height:1.7;color:#64748b") Delivered by a scheduled Lambda function using Amazon SES.
            include ../../partials/footer
